<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QazRent Sign — Облачная CRM и подписание договоров ЭЦП РК</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    @media print {
      body * { visibility: hidden; }
      #printable-contract, #printable-contract * { visibility: visible; }
      #printable-contract { position: absolute; left: 0; top: 0; width: 100%; padding: 15px; background: white; }
      .page-break { page-break-before: always; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

  <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
  <header id="main-header" class="bg-white border-b border-slate-200 sticky top-0 z-30">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-sm">Q</div>
        <div>
          <span class="font-bold text-slate-900 text-lg tracking-tight">QazRent Sign</span>
          <span id="db-status-badge" class="ml-2 text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-medium">Подключение...</span>
        </div>
      </div>

      <div id="landlord-nav" class="flex items-center gap-2">
        <button data-action="open-settings" class="px-3 py-1.5 text-sm rounded-lg border border-slate-300 hover:bg-slate-100 font-medium flex items-center gap-1.5">
          ⚙️ Настройки БД
        </button>
        <button data-action="open-new-contract" class="px-4 py-1.5 text-sm rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-sm">
          + Новый договор + Акт
        </button>
      </div>
    </div>
  </header>

  <!-- ОСНОВНОЙ КОНТЕЙНЕР АРЕНДОДАТЕЛЯ -->
  <main id="landlord-view" class="max-w-6xl mx-auto px-4 py-6 space-y-6">
    <!-- Уведомление об ошибке подключения (показывается только если таблицы не созданы) -->
    <div id="db-error-banner" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-sm text-red-900">
      <div class="font-bold">⚠️ База подключена, но таблицы ещё не созданы или заблокированы</div>
      <p id="db-error-text" class="mt-1 text-xs text-red-700"></p>
    </div>

    <!-- Метрики -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Всего договоров</div>
        <div id="stat-total" class="text-2xl font-bold text-slate-900 mt-1">0</div>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-amber-500">Ожидают подписи клиента</div>
        <div id="stat-pending" class="text-2xl font-bold text-amber-600 mt-1">0</div>
      </div>
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
        <div class="text-xs font-semibold uppercase tracking-wider text-emerald-600">Подписано ЭЦП</div>
        <div id="stat-signed" class="text-2xl font-bold text-emerald-600 mt-1">0</div>
      </div>
    </div>

    <!-- Таблица договоров -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-bold text-slate-800">Реестр договоров найма и актов приёма-передачи</h2>
        <button data-action="refresh-data" class="text-sm text-blue-600 hover:underline font-medium">↻ Обновить список</button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 text-slate-500 text-xs uppercase border-b border-slate-200">
              <th class="py-3 px-4">№ Договора</th>
              <th class="py-3 px-4">Объект аренды</th>
              <th class="py-3 px-4">Квартиросъёмщик</th>
              <th class="py-3 px-4">Сумма (₸)</th>
              <th class="py-3 px-4">Статус ЭЦП</th>
              <th class="py-3 px-4 text-right">Действия</th>
            </tr>
          </thead>
          <tbody id="contracts-tbody" class="divide-y divide-slate-100 text-sm">
            <tr><td colspan="6" class="py-8 text-center text-slate-400">Загрузка договоров из Supabase...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- МОБИЛЬНЫЙ КАБИНЕТ КВАРТИРОСЪЁМЩИКА (?sign=ID) -->
  <section id="tenant-mobile-view" class="hidden max-w-3xl mx-auto px-4 py-6 space-y-5">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
        <div>
          <span class="text-xs font-semibold uppercase tracking-wider text-blue-600">Электронный документооборот РК</span>
          <h1 id="m-contract-title" class="text-xl font-bold text-slate-900 mt-0.5">Договор найма жилья + Акт</h1>
        </div>
        <span id="m-status-badge" class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">Ожидает подписи</span>
      </div>

      <!-- Печатная область: Договор + Приложение №1 (Акт приёма-передачи) -->
      <div id="printable-contract" class="mt-4 text-sm text-slate-700 space-y-4 leading-relaxed bg-slate-50 p-4 sm:p-6 rounded-xl border border-slate-200">
        <!-- Заполняется динамически -->
      </div>

      <!-- Блок подписания со смартфона -->
      <div id="m-sign-controls" class="mt-6 space-y-3">
        <div class="p-3.5 rounded-xl bg-blue-50 border border-blue-100 text-xs text-blue-900">
          Нажимая кнопку подписания, вы подтверждаете согласие с условиями <strong>Договора найма</strong> и <strong>Акта приёма-передачи (показания счётчиков и опись имущества)</strong> с помощью вашей ЭЦП.
        </div>

        <button data-action="sign-egov-mobile" class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-base shadow-md flex items-center justify-center gap-2 transition">
          📱 Подписать через eGov Mobile (с телефона)
        </button>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
          <button data-action="sign-ncalayer-tenant" class="py-2.5 px-3 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-xs font-medium text-slate-700">
            💻 Подписать через NCALayer (с ПК)
          </button>
          <button data-action="sign-demo-tenant" class="py-2.5 px-3 rounded-xl border border-dashed border-blue-300 bg-blue-50/50 hover:bg-blue-50 text-xs font-medium text-blue-700">
            ⚡ Тест-подпись (Демо-режим)
          </button>
        </div>
      </div>

      <!-- Блок после успешного подписания -->
      <div id="m-signed-box" class="hidden mt-6 space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <button onclick="window.print()" class="py-3 px-4 rounded-xl bg-slate-900 text-white font-medium text-sm hover:bg-slate-800">
            🖨️ Скачать / Печать PDF со штампом
          </button>
          <button data-action="download-cms" class="py-3 px-4 rounded-xl border border-slate-300 bg-white text-slate-800 font-medium text-sm hover:bg-slate-50">
            📥 Скачать .CMS контейнер (ЭЦП)
          </button>
        </div>
        <button data-action="back-to-landlord" class="w-full py-2 text-xs text-slate-400 hover:text-slate-600">
          ← Вернуться в кабинет арендодателя
        </button>
      </div>
    </div>
  </section>

  <!-- МОДАЛЬНОЕ ОКНО: НАСТРОЙКИ SUPABASE -->
  <div id="modal-settings" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-bold text-lg text-slate-900">Настройки подключения Supabase</h3>
        <button data-action="close-modals" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>
      <p class="text-xs text-slate-500">Ключи уже вшиты в код по умолчанию. При необходимости здесь можно временно переопределить их для текущего браузера.</p>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Project URL</label>
          <input id="inp-sb-url" type="url" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Publishable / Anon Key</label>
          <input id="inp-sb-key" type="text" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm" />
        </div>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button data-action="reset-settings" class="px-3 py-2 text-xs text-slate-500 hover:text-slate-700 mr-auto">Сбросить к вшитым</button>
        <button data-action="close-modals" class="px-4 py-2 text-sm rounded-lg border border-slate-300">Отмена</button>
        <button data-action="save-settings" class="px-4 py-2 text-sm rounded-lg bg-blue-600 text-white font-medium hover:bg-blue-700">Сохранить</button>
      </div>
    </div>
  </div>

  <!-- МОДАЛЬНОЕ ОКНО: СОЗДАНИЕ ДОГОВОРА + АКТА ПРИЁМА-ПЕРЕДАЧИ -->
  <div id="modal-new-contract" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-2xl w-full p-6 shadow-xl space-y-4 my-8 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 sticky top-0 bg-white z-10">
        <h3 class="font-bold text-lg text-slate-900">Новый договор найма + Акт приёма-передачи</h3>
        <button data-action="close-modals" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>

      <form id="form-contract" class="space-y-4 text-sm">
        <!-- Раздел 1: Основные данные -->
        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-blue-600">1. Условия договора аренды</div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Квартира / Объект</label>
              <input name="property_title" required placeholder="2-комн. кв., ЖК Арман" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Адрес объекта</label>
              <input name="property_address" required placeholder="г. Костанай, ул. Абая 45, кв. 12" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">ФИО Арендодателя (ИП)</label>
              <input name="landlord_name" required placeholder="ИП Саяпина М.В." class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">ИИН Арендодателя</label>
              <input name="landlord_iin" required maxlength="12" pattern="\d{12}" placeholder="810415400123" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">ФИО Квартиросъёмщика</label>
              <input name="tenant_name" required placeholder="Ахметов Серик Берикович" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">ИИН Квартиросъёмщика</label>
              <input name="tenant_iin" required maxlength="12" pattern="\d{12}" placeholder="950820300456" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Телефон (WhatsApp)</label>
              <input name="tenant_phone" required placeholder="77011234567" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Аренда в мес. (₸)</label>
              <input name="rent_amount" type="number" required value="150000" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Депозит (₸)</label>
              <input name="deposit_amount" type="number" value="50000" class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Дата заезда</label>
              <input name="start_date" type="date" required class="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Дата выезда</label>
